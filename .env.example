# NextAuth (generar el secreto con: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth: https://console.cloud.google.com/apis/credentials
# URI de redirección autorizada: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth: https://github.com/settings/developers (OAuth Apps)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# PostgreSQL (opcional). Sin esta variable los usuarios se guardan en data/users.json.
# En Vercel es obligatoria (p. ej. Neon desde el Marketplace).
DATABASE_URL=
